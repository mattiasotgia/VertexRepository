BEGIN_PROLOG

pandoraPassOneConfig: {
    ConfigFile:             "monitoringXml/PandoraSettings_Training_DlVertexPass1.xml" ##< Master file to run in reconstruction
    EnableMCParticles:      true            ##< To be able to cheat is necessary to collapse to MC particles
    SimChannelModuleLabel:  "merge"  ##< Correct sim channel to enable MC particles


    # PrintOverallRecoStatus:     true
}

END_PROLOG

#include "stage1_run2_icarus_MC.fcl"

physics.producers.pandoraGausCryoE: {
    @table::physics.producers.pandoraGausCryoE
    @table::pandoraPassOneConfig
}
physics.producers.pandoraGausCryoW: {
    @table::physics.producers.pandoraGausCryoW
    @table::pandoraPassOneConfig
}

physics.reco: [ 
                @sequence::icarus_reco_Gauss2D_CryoE ,
                @sequence::icarus_reco_Gauss2D_CryoW 
              ]

physics.outana: []

services.message: @local::icarus_message_services_interactive_debug