        <DistanceThresholds>0. 0.00275 0.00825 0.01925 0.03575 0.05775 0.08525 0.12375 0.15125 0.20625 0.26125 0.31625 0.37125 0.42625 0.50875 0.59125 0.67375 0.75625 0.85 1.0</DistanceThresholds>
        <DriftStep>0.3</DriftStep>
    </algorithm>

    <algorithm type = "LArVisualParticleMonitoring">
      <CaloHitListName>CaloHitListV</CaloHitListName>
      <VisualizeMC>true</VisualizeMC>
      <GroupMCByPDG>true</GroupMCByPDG>
    </algorithm>

    <algorithm type = "LArDLVertexing">
        <TrainingMode>true</TrainingMode>
        <VisualiseClasses>true</VisualiseClasses>
        <VisualiseColorMode>auto</VisualiseColorMode>
        <TrainingOutputFileName>ICARUS_DLVertexTrain_Pass1</TrainingOutputFileName>
        <CaloHitListNames>CaloHitListV</CaloHitListNames>
        <DistanceThresholds>0. 0.00275 0.00825 0.01925 0.03575 0.05775 0.08525 0.12375 0.15125 0.20625 0.26125 0.31625 0.37125 0.42625 0.50875 0.59125 0.67375 0.75625 0.85 1.0</DistanceThresholds>
        <DriftStep>0.3</DriftStep>
    </algorithm>

